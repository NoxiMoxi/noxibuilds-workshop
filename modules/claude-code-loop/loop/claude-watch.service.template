# @PROJECT@-claude-watch.service - systemd USER unit for the @PROJECT@ build loop.
# Generated by noxibuilds-workshop init.sh. Install (init.sh never does this for you):
#   cp @PROJECT_DIR@/loop/@PROJECT@-claude-watch.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now @PROJECT@-claude-watch.service
# Never restart it while a run holds the lock:  flock -n @PROJECT_DIR@/state/run.lock true || echo busy
[Unit]
Description=@PROJECT@ - headless Claude Code queue watcher
After=network-online.target

[Service]
Type=simple
Environment=LOOP_CONFIG=@PROJECT_DIR@/loop/loop.env
ExecStart=@PROJECT_DIR@/loop/bin/queue-watch.sh
Restart=on-failure
RestartSec=30
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=default.target
