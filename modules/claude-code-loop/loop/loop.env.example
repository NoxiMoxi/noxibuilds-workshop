# loop.env - configuration for queue-watch.sh (shell syntax). Re-read before every check.
# init.sh writes a filled-in copy to <root>/<project>/loop/loop.env. Keep secrets OUT of this file:
# the notification key lives in the chmod-600 file named by LOOP_NOTIFY_ENV.

LOOP_PROJECT=@PROJECT@                         # lowercase, [a-z][a-z0-9-]{1,38}; used in log lines and payloads
LOOP_DOCS=@PROJECT_DIR@/review-log/docs        # docs/ of the review-log repo (queue, briefs, brain)
LOOP_STATE=@PROJECT_DIR@/state                 # run.lock, last-task.sha, logs, per-run streams, cost ledger
LOOP_WT=@PROJECT_DIR@/wt-loop-run              # the ONE worktree Claude works in (created on first run)
LOOP_APP_REPO=                                 # path to a clone of the app repo (origin = your remote). Required.
LOOP_MAIN_BRANCH=main
LOOP_QUEUE=claude-queue.md

# Claude Code CLI. systemd user units do not load your shell PATH, so give an absolute path.
LOOP_CLAUDE_BIN=
# Extra flags, word-split. Put your unattended permission settings here (an allowlist, never a blanket bypass).
LOOP_CLAUDE_FLAGS=""
LOOP_MODEL_SECURITY=opus                       # security / fix / debug pieces (empty = CLI default)
LOOP_MODEL_FEATURE=sonnet                      # everything else (empty = CLI default)

# Cost caps (USD). Each slice gets min(slice cap, piece budget left); the piece shares the piece budget.
LOOP_PIECE_BUDGET_USD=5
LOOP_SLICE_BUDGET_USD=2

LOOP_BRIEF_MAX_BYTES=20480                     # _loop.md + slice brief; bigger briefs stop the chain
LOOP_MAX_STARTS=4                              # attempts per task hash before needs-owner
LOOP_DEBOUNCE=20                               # seconds of quiet after a queue event before checking
LOOP_DEFAULT_MAX_LINES=300                     # G3 default app-line cap when a brief sets none
LOOP_DEFAULT_MAX_TEST_LINES=120                # G3 default test-line cap

# G4 gate command, run from the worktree root as `<cmd> --full` or `<cmd> --partial -- <test files>`.
LOOP_SELF_CHECK=@PROJECT_DIR@/loop/bin/self-check.sh

# Optional: notification webhook. URL may live here; the key must live in LOOP_NOTIFY_ENV (chmod 600).
LOOP_NOTIFY_URL=
LOOP_NOTIFY_ENV=@PROJECT_DIR@/loop/notify.env
